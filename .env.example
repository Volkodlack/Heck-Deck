# =========================================================
# HEX DECK — Variables d'environnement
# Copie ce fichier en `.env` à la racine du projet.
# Tout est FACULTATIF : sans Supabase, le jeu tourne en mode Invité.
# =========================================================

# ---------- Serveur dédié (optionnel, Node / Socket.io) ----------
PORT=3001
# Origine(s) autorisée(s) pour le client, séparées par des virgules (* = toutes)
CLIENT_ORIGIN=*

# ---------- Client (Vite) — préfixe VITE_ obligatoire ----------
# Supabase : comptes, progression, stats ET mise en relation P2P (mode « En ligne »)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Serveur dédié proposé par défaut dans « Serveur dédié (avancé) » (facultatif)
VITE_SERVER_URL=

# ---------- Génération des visuels (npm run assets) ----------
# Cloudflare Workers AI, palier gratuit : 10 000 neurones/jour
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
