# =========================================================
# HEX DECK — Variables d'environnement
# Copie ce fichier en `.env` à la racine du projet.
# Tout est FACULTATIF : sans Supabase, le jeu tourne en mode Invité.
# =========================================================

# ---------- Serveur (Node / Socket.io) ----------
PORT=3001
# Origine(s) autorisée(s) pour le client, séparées par des virgules
CLIENT_ORIGIN=http://localhost:5173

# Supabase côté serveur : vérifie les jetons et enregistre les statistiques.
# ⚠️ La clé service_role ne doit JAMAIS être exposée au client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Client (Vite) — préfixe VITE_ obligatoire ----------
# URL du serveur Socket.io (par défaut : http://<hôte>:3001 en dev, même origine en prod)
VITE_SERVER_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- Génération des visuels (npm run assets) ----------
# Cloudflare Workers AI, palier gratuit : 10 000 neurones/jour
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
